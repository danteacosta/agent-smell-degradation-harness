{
  "schema_version": "human-annotation/v1",
  "rubric_version": "rubric-v1",
  "labels": ["clean", "minor", "moderate", "severe", "not_visible"],
  "missing_label_policy": {
    "allowed": ["not_visible", "technical_failure", "insufficient_context"],
    "excluded_from_primary_irr": true,
    "never_impute": true
  },
  "blind_fields": ["variant", "defect_family", "oracle_label", "model_id", "artifact"],
  "duplicate_subset_fraction": 0.2,
  "duplicate_subset_seed": 0,
  "primary_irr": {
    "statistic": "krippendorff_alpha",
    "nominal_for": ["clean"],
    "ordinal_order": ["clean", "minor", "moderate", "severe"],
    "bootstrap_replicates": 2000,
    "bootstrap_seed": 0,
    "target": 0.7,
    "adjudication_threshold": 0.6
  },
  "secondary_llm_judges": "exploratory_only"
}
