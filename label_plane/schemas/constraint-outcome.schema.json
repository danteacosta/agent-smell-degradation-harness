{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/danteacosta/agent-smell-degradation-harness/schemas/constraint-outcome.schema.json",
  "title": "T4 constraint outcome",
  "type": "object",
  "additionalProperties": false,
  "required": ["constraint_id", "status", "plane"],
  "properties": {
    "constraint_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["covered", "omitted", "uncertain"]},
    "plane": {"const": "label"},
    "criterion_ids": {"type": "array", "items": {"type": "string"}},
    "review_note": {"type": "string"}
  }
}
